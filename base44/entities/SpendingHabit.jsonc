{
  "name": "SpendingHabit",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Creative, positive habit name"
    },
    "pattern": {
      "type": "string",
      "enum": [
        "presence_over_things",
        "energy_investment",
        "nourishment",
        "momentum_building",
        "growth_exploration",
        "wellbeing_ritual",
        "learning_expansion"
      ],
      "description": "Habit pattern category"
    },
    "monthly_average": {
      "type": "number",
      "description": "Average monthly spending on this habit"
    },
    "color": {
      "type": "string",
      "description": "Hex color for visualization"
    },
    "emoji": {
      "type": "string",
      "description": "Emoji representing the habit"
    },
    "insight_message": {
      "type": "string",
      "description": "Personalized, positive insight about this habit"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "sporadic"
      ],
      "description": "How often this habit occurs"
    }
  },
  "required": [
    "name",
    "pattern",
    "monthly_average",
    "color",
    "emoji"
  ]
}