{
  "name": "Loan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the loan"
    },
    "original_balance": {
      "type": "number",
      "description": "Original loan amount"
    },
    "current_balance": {
      "type": "number",
      "description": "Current remaining balance"
    },
    "interest_rate": {
      "type": "number",
      "description": "Annual interest rate as percentage"
    },
    "minimum_payment": {
      "type": "number",
      "description": "Minimum monthly payment"
    },
    "category": {
      "type": "string",
      "enum": [
        "student",
        "auto",
        "mortgage",
        "credit_card",
        "personal",
        "medical",
        "other"
      ],
      "description": "Type of loan"
    },
    "icon": {
      "type": "string",
      "description": "Emoji icon for the loan"
    },
    "color": {
      "type": "string",
      "description": "Hex color for the loan"
    },
    "extra_payment": {
      "type": "number",
      "default": 0,
      "description": "Extra monthly payment amount"
    }
  },
  "required": [
    "name",
    "current_balance",
    "interest_rate",
    "minimum_payment"
  ]
}